# Copie este arquivo pra .env.local (que já está no .gitignore) e preencha
# com os valores do seu projeto Supabase (Project Settings → API).
# Sem essas variáveis, o app funciona normalmente em modo somente-leitura
# com localStorage (ver storage.js) — não trava o build nem o dev.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
